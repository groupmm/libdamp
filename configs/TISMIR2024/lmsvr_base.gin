include 'configs/base.gin'

# Override Experiment defaults
Experiment.name = "tismir2024_lmsvr_{date}"
Experiment.early_stopping = False
Experiment.save_best_n_ckpts = 1
Experiment.max_epochs = 40
Experiment.batch_size = 32
Experiment.limit_val_batches = 1.0
Experiment.shuffle_data = True

sampling_rate = 16000.
frame_len = 320 # 20 ms
excerpt_len = 64000 # 4 s

# Load and configure the specific experiment
import experiments.TISMIR2024.lmsvr_baseline

libdamp.experiment = @LMSVRBaselineExperiment()

LMSVRBaselineExperiment.fs = %sampling_rate
LMSVRBaselineExperiment.frame_len = %frame_len

LMSVRBaselineExperiment.n_fft_mel = 2048
LMSVRBaselineExperiment.n_mels = 64
LMSVRBaselineExperiment.f_min_mel = 50.0
LMSVRBaselineExperiment.f_max_mel = 8000.0

LMSVRBaselineExperiment.filt_len = 320
LMSVRBaselineExperiment.num_bands_ti = 64
LMSVRBaselineExperiment.num_bands_tv = 64
LMSVRBaselineExperiment.num_bands_noise = 10

LMSVRBaselineExperiment.model_size_control = 512

LMSVRBaselineExperiment.learning_rate = 1e-4

LMSVRBaselineExperiment.loss_fn = @MSSLoss()
MSSLoss.w_mag = 1.0
MSSLoss.w_log = 1.0
MSSLoss.fft_sizes = (2048, 1024, 512, 256, 128, 64)
MSSLoss.win = "hann"

dataset_path = "~/Desktop/datasets/lm-ssd/LM-SSD/audio"

# The exact data splits are defined in the separate config files in the subfolder "data_splits"
libdamp.train_dataset = @train/LMSSDDataset()
libdamp.val_dataset = @val/LMSSDDataset()

LMSSDDataset.target_fs = %sampling_rate
LMSSDDataset.excerpt_len = %excerpt_len
LMSSDDataset.random_seed = 42

train/LMSSDDataset.path = %dataset_path
train/LMSSDDataset.num_excerpts = 1000 # per file
val/LMSSDDataset.path = %dataset_path
val/LMSSDDataset.num_excerpts = 100
