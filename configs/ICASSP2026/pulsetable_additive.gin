include 'configs/base.gin'

########
# override defaults of Experiment
########
Experiment.name="icassp2026_additive_{date}"
Experiment.early_stopping = False
Experiment.early_stopping_patience = 20
Experiment.save_best_n_ckpts = 1
Experiment.max_epochs = 40
Experiment.batch_size = 32
Experiment.limit_val_batches = 1.0
Experiment.shuffle_data = True

sampling_rate = 48000.
frame_len = 128
num_excerpts = 500 # per item
num_frames = 1500 # -> 4 seconds

########
# load and configure a specific experiment
########
import experiments.ICASSP2026.pulsetable_additive_baseline

libdamp.experiment = @AdditivePulseTableExperiment()

AdditivePulseTableExperiment.fs = %sampling_rate
AdditivePulseTableExperiment.N = %frame_len
AdditivePulseTableExperiment.learning_rate = 1e-3

AdditivePulseTableExperiment.num_harm = 100

AdditivePulseTableExperiment.learn_gain = True
AdditivePulseTableExperiment.learn_noise = True
AdditivePulseTableExperiment.learn_post_filter = True
AdditivePulseTableExperiment.learn_freq_offset = False

AdditivePulseTableExperiment.model_size_weights = 256
AdditivePulseTableExperiment.model_size_gain = 32
AdditivePulseTableExperiment.model_size_freq = 32
AdditivePulseTableExperiment.model_size_noise = 48

AdditivePulseTableExperiment.envelope_oversampling = 1

AdditivePulseTableExperiment.w_entropy = 1
AdditivePulseTableExperiment.w_sparsity = 0.005

AdditivePulseTableExperiment.loss_fn = @MSSLoss()
MSSLoss.w_mag = 10.0
MSSLoss.w_log = 0.0
MSSLoss.w_mlog = 5.0
MSSLoss.mgamma = 10.0
MSSLoss.p = 1
MSSLoss.fft_sizes = (4096, 2048, 1024, 512, 64)
MSSLoss.win = "flattop"


########
# load and configure datasets for train/val/test
########
libdamp.train_dataset = @train/PulseItDataset()
libdamp.val_dataset = @val/PulseItDataset()
libdamp.test_dataset = @test/PulseItDataset()

PulseItDataset.M = %num_excerpts
PulseItDataset.H = %frame_len
PulseItDataset.L = %num_frames
